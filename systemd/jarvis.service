[Unit]
Description=J.A.R.V.I.S. Mk.II Enterprise Relay
After=network.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis
EnvironmentFile=/opt/jarvis/.env
ExecStart=/opt/jarvis/venv/bin/python /opt/jarvis/server.py
Restart=always
RestartSec=5
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/jarvis

[Install]
WantedBy=multi-user.target
