# =============================================================================
# J.A.R.V.I.S. Mk.II Enterprise — Environment Configuration
# =============================================================================
# Copy this file to .env and edit before deployment.

# --- Security ---
# Generate with: openssl rand -hex 32
JARVIS_SECRET=B16EBCA9F0415A8C3AC46E02A7FFC1BA11CBFCCBC61602278C5AAD8829629D1D

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
DB_PATH=jarvis.db

# --- Rate Limiting (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Access Control ---
# Comma-separated list of allowed CIDRs or IPs. Empty = allow all (not recommended for prod).
ALLOWED_IPS=127.0.0.1,::1

# --- Admin ---
ADMIN_EMAIL=admin@yourdomain.com

# --- Domain & TLS ---
# Public domain for WSS/WebRTC and dashboard
DOMAIN=jarvis.yourdomain.com
# Path to SSL cert/key if terminating at Nginx
SSL_CERT_PATH=/etc/letsencrypt/live/jarvis.yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/jarvis.yourdomain.com/privkey.pem

# --- Features ---
ENABLE_WEBRTC=true
ENABLE_REMOTE_SHELL=true
ENABLE_FILE_TRANSFER=true
MAX_FILE_SIZE_GB=5

# --- Session Rotation (Perfect Forward Secrecy) ---
SESSION_ROTATION_GB=1
SESSION_ROTATION_HOURS=24

# --- Offline Queue ---
OFFLINE_QUEUE_TTL_HOURS=24

# --- Device Enrollment (fill after /auth/enroll) ---
LAPTOP_DEVICE_ID=laptop
LAPTOP_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJsYXB0b3AiLCJleHAiOjE3OTUxMDc3NTF9.aGKCUQosX7hdlIoHmw8x_Ue0iimu8IvLBIoXXMOL5vc
SERVER_URL=ws://localhost:8765/ws
